{
    "type": "postgres",
    "name": "Extract Data from a PostgreSQL Database Table",
    "connection": {
        "host": "localhost",
        "port": 5432,
        "database": "your_database",
        "username": "your_username",
        "password": "your_password",
        "sslmode": "prefer",
        "connect_timeout": 10
    },
    "schema": "public",
    "table": "your_table",
    "query": "SELECT * FROM public.your_table",
    "mapping": [
        {
            "target_field": "Field1",
            "data_type": "string"
        },
        {
            "target_field": "Field2",
            "data_type": "integer"
        },
        {
            "target_field": "Field3",
            "data_type": "datetime"
        }
    ]
}
